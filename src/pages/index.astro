---
import '../styles/global.css';
---

<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>Draw a Perfect Star</title>

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Darumadrop+One&display=swap" rel="stylesheet">
</head>

<body class="min-h-screen overflow-hidden text-white">

	<div class="fixed inset-0 bg-slate-950">
		<div
			class="absolute inset-0"
			style="
				background:
				radial-gradient(circle at 20% 20%, rgba(34,211,238,.15), transparent 40%),
				radial-gradient(circle at 80% 70%, rgba(168,85,247,.15), transparent 40%),
				linear-gradient(135deg,#020617,#0f172a,#111827);
			"
		></div>

		<div
			class="absolute inset-0 opacity-[0.04]"
			style="
				background-image:
					linear-gradient(rgba(255,255,255,.3) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255,255,255,.3) 1px, transparent 1px);
				background-size:40px 40px;
			"
		></div>
	</div>

	<main class="relative z-10 flex min-h-screen flex-col items-center justify-center px-4">

		<h1
			class="mb-8 text-center text-6xl md:text-7xl"
			style="
				font-family:'Darumadrop One',cursive;
				animation: float 5s ease-in-out infinite;
			"
		>
			Draw a Perfect Star
		</h1>

		<div class="relative w-[600px] h-[600px] max-w-[90vw] max-h-[90vw]">

			<div
				class="absolute inset-0 rounded-[32px] pointer-events-none opacity-0"
				style="
					background:rgba(255,255,255,.03);
					backdrop-filter:blur(12px);
					border:1px solid rgba(255,255,255,.08);
					box-shadow:
						0 0 80px rgba(34,211,238,.08),
						0 0 120px rgba(168,85,247,.06);
				"
			></div>

			<canvas
				id="c"
				width="600"
				height="600"
				class="absolute inset-0 z-10 w-full h-full rounded-[32px] touch-none"
			></canvas>

			<div
				class="
					absolute left-1/2 top-1/2
					-translate-x-1/2 -translate-y-1/2
					z-20 pointer-events-none
				"
			>
				<div
					class="
						w-3 h-3 rounded-full bg-white
						animate-pulse
					"
					style="
						box-shadow:
							0 0 10px rgba(255,255,255,.9),
							0 0 25px rgba(255,255,255,.5);
					"
				></div>
			</div>

			<div
				class="absolute top-4 left-1/2 -translate-x-1/2 z-20 px-5 py-2 rounded-full pointer-events-none"
				style="
					background:rgba(255,255,255,.08);
					backdrop-filter:blur(10px);
					border:1px solid rgba(255,255,255,.08);
				"
			>
				<div
					id="score"
					class="text-xl font-bold transition-all duration-300"
				>
					Accuracy: -
				</div>
			</div>

		</div>

		<button
			id="resetBtn"
			class="mt-6 px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 transition"
		>
			Reset
		</button>

	</main>

	<script>
		const canvas = document.getElementById("c");
		const ctx = canvas.getContext("2d");
		const scoreEl = document.getElementById("score");

		let drawing = false;
		let locked = false;
		let path = [];

		function getPos(e) {
			const r = canvas.getBoundingClientRect();

			return {
				x: (e.clientX - r.left) * (canvas.width / r.width),
				y: (e.clientY - r.top) * (canvas.height / r.height)
			};
		}

		canvas.addEventListener("mousedown", (e) => {
			if (locked) return;

			drawing = true;
			path = [];

			const p = getPos(e);
			path.push(p);
		});

		window.addEventListener("mouseup", () => {
			if (!drawing) return;

			drawing = false;
			locked = true;

			const s = getScore();
			updateScore(s);
		});

		canvas.addEventListener("mousemove", (e) => {
			if (!drawing || locked) return;

			const p = getPos(e);
			path.push(p);

			if (path.length > 1) {
				const a = path[path.length - 2];
				const b = path[path.length - 1];

				ctx.beginPath();
				ctx.moveTo(a.x, a.y);
				ctx.lineTo(b.x, b.y);
				ctx.strokeStyle = "white";
				ctx.lineWidth = 4;
				ctx.lineCap = "round";
				ctx.stroke();
			}

			updateScore(getScore());
		});

		function dist(a, b) {
			return Math.hypot(a.x - b.x, a.y - b.y);
		}

		function resample(points, n = 120) {
			if (points.length < 2) return points;

			let dists = [0];

			for (let i = 1; i < points.length; i++) {
				dists[i] = dists[i - 1] + dist(points[i], points[i - 1]);
			}

			const total = dists[dists.length - 1];
			const step = total / (n - 1);

			let out = [];
			let j = 0;

			for (let i = 0; i < n; i++) {
				const target = i * step;

				while (j < dists.length - 1 && dists[j] < target) {
					j++;
				}

				const i1 = Math.max(0, j - 1);
				const i2 = j;

				const p1 = points[i1];
				const p2 = points[i2] || p1;

				const d1 = dists[i1];
				const d2 = dists[i2];

				const t = (target - d1) / ((d2 - d1) || 1);

				out.push({
					x: p1.x + (p2.x - p1.x) * t,
					y: p1.y + (p2.y - p1.y) * t
				});
			}

			return out;
		}

		function normalize(points) {
			let cx = 0;
			let cy = 0;

			for (const p of points) {
				cx += p.x;
				cy += p.y;
			}

			cx /= points.length;
			cy /= points.length;

			const shifted = points.map(p => ({
				x: p.x - cx,
				y: p.y - cy
			}));

			let maxR = 0;

			for (const p of shifted) {
				maxR = Math.max(maxR, Math.hypot(p.x, p.y));
			}

			return shifted.map(p => ({
				x: p.x / maxR,
				y: p.y / maxR
			}));
		}

		function makeStar(n = 120) {
			const pts = [];

			for (let i = 0; i < n; i++) {
				const t = i / n;
				const a = t * Math.PI * 2 - Math.PI / 2;

				const r = Math.sin(a * 5) > 0 ? 1 : 0.45;

				pts.push({
					x: Math.cos(a) * r,
					y: Math.sin(a) * r
				});
			}

			return pts;
		}

		function getScore() {
			if (path.length < 10) return 0;

			const user = normalize(resample(path));
			const star = makeStar();

			let error = 0;

			for (let i = 0; i < user.length; i++) {
				error += Math.hypot(
					user[i].x - star[i].x,
					user[i].y - star[i].y
				);
			}

			error /= user.length;

			const score = 100 - error * 120;
			return Math.max(0, Math.min(100, score));
		}

		function updateScore(score) {
			scoreEl.textContent = `Accuracy: ${score.toFixed(1)}%`;

			const hue = score * 1.2;

			scoreEl.style.color =
				`hsl(${hue},100%,70%)`;

			scoreEl.style.textShadow =
				`0 0 20px hsla(${hue},100%,70%,0.7)`;
		}

		document.getElementById("resetBtn").addEventListener("click", () => {
			ctx.clearRect(0, 0, canvas.width, canvas.height);

			path = [];
			drawing = false;
			locked = false;

			scoreEl.textContent = "Accuracy: -";
			scoreEl.style.color = "";
			scoreEl.style.textShadow = "";
		});
	</script>

	<style>
		@keyframes float {
			0%,100% {
				transform: translateY(0);
			}
			50% {
				transform: translateY(-10px);
			}
		}
	</style>

</body>
</html>